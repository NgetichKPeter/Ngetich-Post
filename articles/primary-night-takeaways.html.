<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Primary night takeaways: Trump demonstrates his power over GOP - Ngetich Post</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chivo:wght@300;400;700&family=Lora:ital,wght@0,400;0,700;1,400&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background-color: #121212; color: #ffffff; font-family: 'Chivo', sans-serif; line-height: 1.6; }
        
        header { border-bottom: 1px solid #2d2d2d; padding: 15px; text-align: center; background: #121212; position: sticky; top: 0; z-index: 100; }
        .logo { font-family: 'Playfair Display', serif; font-size: 24px; color: white; text-decoration: none; font-weight: 700; }
        
        main { max-width: 650px; margin: 0 auto; padding: 24px 16px; }
        .category { color: #116efc; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; display: block; }
        h1 { font-family: 'Lora', serif; font-size: 32px; line-height: 1.2; margin-bottom: 12px; font-weight: 700; }
        .subheadline { font-size: 18px; color: #aaaaaa; margin-bottom: 16px; line-height: 1.4; }
        .meta { font-size: 13px; color: #888888; margin-bottom: 24px; border-bottom: 1px solid #2d2d2d; padding-bottom: 16px; }
        
        .featured-img { width: 100%; height: auto; border-radius: 4px; margin-bottom: 8px; }
        .caption { font-size: 13px; color: #aaaaaa; margin-bottom: 24px; line-height: 1.4; }
        
        .article-body { font-family: 'Lora', serif; font-size: 18px; color: #e0e0e0; margin-bottom: 40px; }
        .article-body p { margin-bottom: 20px; }

        /* --- LOCAL CUSTOM COMMENTS SECTION --- */
        .comments-section { border-top: 2px solid #2d2d2d; padding-top: 30px; margin-top: 40px; }
        .comments-title { font-family: 'Playfair Display', serif; font-size: 22px; margin-bottom: 20px; color: white; }
        
        .comment-form { background: #1a1a1a; padding: 16px; border-radius: 6px; margin-bottom: 24px; border: 1px solid #2d2d2d; }
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 12px; color: #aaa; margin-bottom: 4px; font-weight: 700; }
        .form-input { width: 100%; padding: 10px; background-color: #121212; border: 1px solid #333; color: white; border-radius: 4px; font-family: inherit; font-size: 14px; outline: none; }
        
        .btn-comment { background-color: #116efc; color: white; border: none; padding: 10px 16px; border-radius: 4px; font-weight: 700; cursor: pointer; font-size: 14px; }
        
        /* Rendered Comments List */
        .comment-list { display: flex; flex-direction: column; gap: 16px; }
        .comment-card { background: #161616; border-left: 3px solid #116efc; padding: 14px; border-radius: 4px; position: relative; }
        .comment-meta { font-size: 13px; font-weight: 700; color: #e0e0e0; margin-bottom: 6px; display: flex; justify-content: space-between; }
        .comment-date { font-weight: 400; color: #666; font-size: 11px; }
        .comment-text { font-size: 15px; color: #cccccc; line-height: 1.4; word-break: break-word; }
        
        /* Secret Delete Button for Author */
        .delete-comment-btn { display: none; background: none; border: none; color: #ff3b30; font-size: 12px; cursor: pointer; font-weight: 700; }
        body.admin-mode .delete-comment-btn { display: inline-block; }
        
        .admin-toggle-btn { background: none; border: 1px dashed #444; color: #444; padding: 4px 8px; font-size: 10px; border-radius: 4px; margin-top: 20px; cursor: pointer; display: inline-block; }
    </style>
</head>
<body>

    <header>
        <a href="../index.html" class="logo">The Ngetich Post</a>
    </header>

    <main>
        <span class="category">Politics</span>
        <h1>Primary night takeaways: Trump demonstrates his power over GOP</h1>
        <p class="subheadline">The president’s favorites swept Republican foes in Georgia, Pennsylvania and Kentucky.</p>
        
        <div class="meta">
            <p>By <strong>Hannah Knowles</strong>, <strong>Dan Merica</strong> and <strong>Patrick Marley</strong></p>
            <p style="margin-top: 4px;">Updated May 20, 2026</p>
        </div>

        <img src="https://images.unsplash.com/photo-1541872703-74c5e44368f9?w=800" alt="Politics Graphic" class="featured-img">
        <p class="caption">Rep. Thomas Massie (R-Kentucky), left, lost to Ed Gallrein. (AFP/Getty Images)</p>

        <div class="article-body">
            <p>WASHINGTON—The primary elections solidified dramatic shifts within the party framework as voters turned out in key states to decide pivotal congressional and gubernatorial matchups.</p>
            <p>In Georgia and Pennsylvania, high-profile endorsements carried substantial weight, signaling an aggressive push toward the upcoming general elections.</p>
        </div>

        <section class="comments-section">
            <h3 class="comments-title">Reader Discussion</h3>
            
            <div class="comment-form">
                <div class="form-group">
                    <label>Your Name</label>
                    <input type="text" id="commenterName" class="form-input" placeholder="Enter your name...">
                </div>
                <div class="form-group">
                    <label>Comment</label>
                    <textarea id="commenterText" class="form-input" rows="3" placeholder="What are your thoughts on this story?"></textarea>
                </div>
                <button class="btn-comment" onclick="submitLocalComment()">Post Comment</button>
            </div>

            <div class="comment-list" id="commentListContainer"></div>
            
            <span class="admin-toggle-btn" onclick="toggleModerationMode()">🔒 Moderate Profile</span>
        </section>
    </main>

    <script>
        // Unique article key identifier
        const STORAGE_KEY = "comments_primary_night";

        // Load comments instantly when page opens
        window.onload = function() {
            renderComments();
        };

        function submitLocalComment() {
            const nameField = document.getElementById('commenterName');
            const textField = document.getElementById('commenterText');
            
            const name = nameField.value.trim() || "Anonymous Reader";
            const text = textField.value.trim();

            if (!text) { alert("Please type a comment before posting."); return; }

            // Create timestamp layout
            const options = { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute:'2-digit' };
            const timestamp = new Date().toLocaleDateString("en-US", options);

            const newComment = {
                id: Date.now(),
                author: name,
                content: text,
                date: timestamp
            };

            // Grab existing array or create a clean one
            let existingComments = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
            existingComments.unshift(newComment); // Put newest comment on top

            localStorage.setItem(STORAGE_KEY, JSON.stringify(existingComments));

            // Clear form inputs and update view
            nameField.value = '';
            textField.value = '';
            renderComments();
        }

        function renderComments() {
            const container = document.getElementById('commentListContainer');
            let comments = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
            
            if(comments.length === 0) {
                container.innerHTML = `<p style="font-size:14px; color:#555; font-style:italic;">No comments posted yet. Be the first to share your thoughts!</p>`;
                return;
            }

            container.innerHTML = comments.map(comment => `
                <div class="comment-card" id="card-${comment.id}">
                    <div class="comment-meta">
                        <span>✍️ ${escapeHtml(comment.author)}</span>
                        <span class="comment-date">${comment.date}</span>
                    </div>
                    <p class="comment-text">${escapeHtml(comment.content)}</p>
                    <div style="margin-top: 8px; text-align: right;">
                        <button class="delete-comment-btn" onclick="deleteComment(${comment.id})">🗑️ Delete Comment</button>
                    </div>
                </div>
            `).join('');
        }

        function deleteComment(commentId) {
            if(confirm("Are you sure you want to remove this comment from your layout?")) {
                let comments = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
                comments = comments.filter(c => c.id !== commentId);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(comments));
                renderComments();
            }
        }

        function toggleModerationMode() {
            document.body.classList.toggle('admin-mode');
            if(document.body.classList.contains('admin-mode')) {
                alert("Moderation Mode Active: You can now delete any comments on this browser.");
            }
        }

        // Helper function to keep input fields clean and secure
        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>

</body>
</html>
